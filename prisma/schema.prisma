generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model groups_ {
  group_id                               Int           @id @default(autoincrement())
  group_zone_id                          Int?
  location_id                            Int?
  community                              Int?
  description                            String?       @db.Text
  meet_day                               String?       @db.VarChar(20)
  meet_time                              String?       @db.VarChar(20)
  members_capacity                       Int?
  members_count                          Int?          @default(0)
  status                                 String?       @db.VarChar(100)
  comments                               String?       @db.Text
  updated_at                             DateTime?     @default(now()) @db.DateTime(0)
  created_at                             DateTime?     @default(now()) @db.DateTime(0)
  assignments                            assignments[]
  groups_zones                           groups_zones? @relation(fields: [group_zone_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "groups__ibfk_1")
  locations                              locations?    @relation(fields: [location_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "groups__ibfk_2")
  community_groups__communityTocommunity community?    @relation("groups__communityTocommunity", fields: [community], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "groups__ibfk_3")
  users                                  users[]

  @@index([community], map: "community")
  @@index([group_zone_id], map: "group_zone_id")
  @@index([location_id], map: "location_id")
}

model roles {
  role_id   Int     @id @default(autoincrement())
  role_name String? @db.VarChar(50)
  users     users[]
}

model zones {
  id          Int           @id @default(autoincrement())
  zone_name   String        @db.VarChar(100)
  assignments assignments[]
  locations   locations[]
}

model users {
  id              Int       @id @default(autoincrement())
  user_id         String?   @db.VarChar(150)
  name            String?   @db.VarChar(50)
  last_name       String?   @db.VarChar(50)
  dni             String?   @unique(map: "dni") @db.VarChar(30)
  birthday        DateTime? @db.Date
  phone           String?   @db.VarChar(30)
  email           String?   @unique(map: "email") @db.VarChar(100)
  password        String?   @db.VarChar(255)
  role_id         Int?
  group_id        Int?
  isEmailVerified Boolean?  @default(false)
  isActive        Boolean?  @default(false)
  last_login      DateTime? @db.DateTime(0)
  updated_at      DateTime? @default(now()) @db.DateTime(0)
  created_at      DateTime? @default(now()) @db.DateTime(0)
  groups_         groups_?  @relation(fields: [group_id], references: [group_id], onDelete: NoAction, onUpdate: NoAction, map: "users_ibfk_1")
  roles           roles?    @relation(fields: [role_id], references: [role_id], onDelete: NoAction, onUpdate: NoAction, map: "users_ibfk_2")

  @@index([group_id], map: "group_id")
  @@index([role_id], map: "role_id")
}

model hash {
  id    Int    @id @default(autoincrement())
  hash  String @unique(map: "hash") @db.VarChar(150)
  email String @db.VarChar(100)
}

model assignment_status {
  id          Int           @id @default(autoincrement())
  status      String?       @db.VarChar(50)
  description String?       @db.VarChar(200)
  assignments assignments[]
}

model community {
  id                                   Int       @id @default(autoincrement())
  name                                 String?   @db.VarChar(100)
  groups__groups__communityTocommunity groups_[] @relation("groups__communityTocommunity")
}

model groups_zones {
  id        Int       @id @default(autoincrement())
  zone_id   String?   @db.VarChar(50)
  leader_id Int?
  groups_   groups_[]
}

model locations {
  id            Int           @id @default(autoincrement())
  location_name String        @db.VarChar(100)
  zone_id       Int?
  assignments   assignments[]
  groups_       groups_[]
  zones         zones?        @relation(fields: [zone_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "locations_ibfk_1")

  @@index([zone_id], map: "zone_id")
}

model assignments {
  id                    Int                @id @default(autoincrement())
  name                  String?            @db.VarChar(50)
  last_name             String?            @db.VarChar(50)
  age                   Int?
  gender                String?            @db.VarChar(25)
  marital_status        String?            @db.VarChar(15)
  phone                 String?            @db.VarChar(25)
  email                 String?            @db.VarChar(50)
  attend_with           String?            @db.VarChar(30)
  hillsong_is_my_church Boolean?
  has_selected_group    Boolean?
  group_selected        Int?
  member_from           String?            @db.VarChar(25)
  service_selected      String?            @db.VarChar(25)
  location              Int?
  zone                  Int?
  status                Int?
  comments              String?            @db.VarChar(255)
  created_at            DateTime?          @db.DateTime(0)
  updated_at            DateTime?          @db.DateTime(0)
  groups_               groups_?           @relation(fields: [group_selected], references: [group_id], onDelete: NoAction, onUpdate: NoAction, map: "assignments_ibfk_1")
  locations             locations?         @relation(fields: [location], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "assignments_ibfk_2")
  assignment_status     assignment_status? @relation(fields: [status], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "assignments_ibfk_3")
  zones                 zones?             @relation(fields: [zone], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "assignments_ibfk_4")

  @@index([group_selected], map: "group_selected")
  @@index([location], map: "location")
  @@index([status], map: "status")
  @@index([zone], map: "zone")
}
